<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the macOS app (see docs/releasing.md).
  - allow-jit: V8 needs it on Apple Silicon under the hardened runtime.
  - disable-library-validation: lets the ad-hoc-signed build load Electron's
    pre-signed frameworks; can be dropped once builds are signed with a
    Developer ID certificate (and the app still launches).
  - device.bluetooth: trainers, heart-rate straps and controllers are BLE.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.device.bluetooth</key>
    <true/>
  </dict>
</plist>
