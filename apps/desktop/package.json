{
  "name": "@freilauf/desktop",
  "productName": "Freilauf",
  "desktopName": "freilauf.desktop",
  "version": "0.0.0",
  "description": "Local-first indoor cycling: smart trainer, virtual shifting, stats overlay and peer-to-peer group rides",
  "author": "Freilauf contributors",
  "homepage": "https://github.com/graemer-org/freilauf",
  "repository": {
    "type": "git",
    "url": "https://github.com/graemer-org/freilauf.git",
    "directory": "apps/desktop"
  },
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:sim": "cross-env FREILAUF_SIM=1 electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && node build/check-bundle.mjs && electron-builder --publish never",
    "dist:dir": "electron-vite build && node build/check-bundle.mjs && electron-builder --dir --publish never",
    "typecheck": "tsc --noEmit -p .",
    "test:e2e": "electron-vite build && playwright test --trace off"
  },
  "dependencies": {
    "@freilauf/devices": "workspace:*",
    "@freilauf/p2p": "workspace:*",
    "@freilauf/session": "workspace:*",
    "@freilauf/sim": "workspace:*",
    "@freilauf/workouts": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.8"
  }
}
