{
  "name": "freilauf",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "pnpm --filter @freilauf/desktop dev",
    "dev:sim": "pnpm --filter @freilauf/desktop dev:sim",
    "build": "pnpm --filter @freilauf/desktop build",
    "signalling": "pnpm --filter @freilauf/signalling start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @freilauf/desktop test:e2e",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
